<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Portable: RID/self-contained only via build.bat publish, not in project defaults.
         Avoids restore/build failures when the folder is copied to another PC. -->
  </PropertyGroup>

  <!-- Never compile leftover nested copies if someone unpacks an old ZIP. -->
  <ItemGroup>
    <Compile Remove="AutoInputTester_FIXED_V6\**" />
    <Page Remove="AutoInputTester_FIXED_V6\**" />
    <None Remove="AutoInputTester_FIXED_V6\**" />
    <EmbeddedResource Remove="AutoInputTester_FIXED_V6\**" />
  </ItemGroup>
</Project>
