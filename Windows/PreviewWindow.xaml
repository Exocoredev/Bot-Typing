<Window x:Class="AutoInputTester.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR-Vorschau" Width="760" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="CountText" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="TextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="15" TextChanged="TextBox_TextChanged"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" Width="100" Margin="4" IsCancel="True"/>
            <Button Content="Übernehmen" Width="110" Margin="4" IsDefault="True" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
